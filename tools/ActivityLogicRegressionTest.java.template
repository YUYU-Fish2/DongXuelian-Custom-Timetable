    /* ACTUAL_METHODS */

    public static void main(String[] args) throws Exception {
        TimeZone original = TimeZone.getDefault();
        int failures = 0;
        try {
            TimeZone.setDefault(TimeZone.getTimeZone("Asia/Shanghai"));
            ActivityLogicRegressionTest app = new ActivityLogicRegressionTest();
            failures += run("date suffix", () -> check(app.parseDateMillis("2026-03-02junk") == null,
                    "Trailing garbage accepted as a calendar date"));
            failures += run("date width", () -> check(app.parseDateMillis("2026-3-2") == null,
                    "Non YYYY-MM-DD date accepted"));
            failures += run("valid dates", () -> {
                check(app.parseDateMillis("2026-02-30") == null, "Impossible date accepted");
                check(app.parseDateMillis("2024-02-29") != null, "Leap day rejected");
                check(app.parseDateMillis(" 2026-03-02 ") != null, "Trimmed valid date rejected");
            });
            TimeZone.setDefault(TimeZone.getTimeZone("America/New_York"));
            app.calendarStart = date(2026, Calendar.MARCH, 2);
            app.calendarEnd = date(2026, Calendar.MARCH, 16);
            app.today = date(2026, Calendar.MARCH, 9);
            failures += run("DST current week", () -> check(app.currentTeachingWeek() == 2,
                    "Spring DST moves Monday into week " + app.currentTeachingWeek()));
            failures += run("DST total weeks", () -> check(app.calendarTotalWeeks() == 3,
                    "Spring DST loses the final teaching week"));
            failures += run("DST week label", () -> check(app.weekRangeLabel(2).equals("第2周 · 3.9–3.15"),
                    "Wrong week label: " + app.weekRangeLabel(2)));
            app.calendarStart = date(2026, Calendar.OCTOBER, 26);
            app.calendarEnd = date(2026, Calendar.NOVEMBER, 9);
            app.today = date(2026, Calendar.NOVEMBER, 2);
            failures += run("fall DST week label", () -> check(app.weekRangeLabel(2).equals("第2周 · 11.2–11.8"),
                    "Fall DST shifts labels to the preceding Sunday: " + app.weekRangeLabel(2)));
            failures += run("current reminder", () -> assertReminder(7, 1, true));
            failures += run("UI spring DST date", () -> {
                app.calendarStart = date(2026, Calendar.MARCH, 2);
                check(app.displayedDateMillis(2, 0) == date(2026, Calendar.MARCH, 9), "Spring UI Monday shifted");
                check(app.displayedWeekRangeLabel(2).equals("3.9–3.15"), "Spring UI range shifted");
            });
            failures += run("UI fall DST date", () -> {
                app.calendarStart = date(2026, Calendar.OCTOBER, 26);
                check(app.displayedDateMillis(2, 0) == date(2026, Calendar.NOVEMBER, 2), "Fall UI Monday shifted");
                check(app.displayedWeekRangeLabel(2).equals("11.2–11.8"), "Fall UI range shifted");
            });
            TimeZone.setDefault(TimeZone.getTimeZone("Asia/Shanghai"));
            failures += run("UI cross-month date", () -> {
                app.calendarStart = date(2026, Calendar.SEPTEMBER, 28);
                check(app.displayedDateMillis(1, 6) == date(2026, Calendar.OCTOBER, 4), "Sunday month rollover wrong");
                check(app.displayedWeekRangeLabel(1).equals("9.28–10.4"), "Cross-month UI range wrong");
            });
            failures += run("UI cross-year and final week", () -> {
                app.calendarStart = date(2026, Calendar.DECEMBER, 28);
                check(app.displayedDateMillis(1, 6) == date(2027, Calendar.JANUARY, 3), "Year rollover wrong");
                check(app.displayedWeekRangeLabel(1).equals("12.28–1.3"), "Year range wrong");
                check(app.displayedDateMillis(17, 6) == date(2027, Calendar.APRIL, 25), "Final week Sunday wrong");
            });
            failures += run("timeline interpolation and clamps", () -> {
                check(timelinePosition(0, 10, 20, 30, 130) == 30, "Before interval extrapolated");
                check(timelinePosition(15, 10, 20, 30, 130) == 80, "Half progress incorrect");
                check(timelinePosition(30, 10, 20, 30, 130) == 130, "After interval extrapolated");
                check(timelinePosition(780, 700, 870, 100, 270) == 180, "13:00 break interpolation incorrect");
                check(Float.isFinite(timelinePosition(20, 20, 20, 30, 130)), "Zero interval produced NaN");
            });
            failures += run("stale reminder", () -> assertReminder(6, 1, false));
            failures += run("removed course reminder", () -> assertReminder(7, 2, false));
            failures += run("null reminder", () -> {
                Context c = new Context();
                new ActivityLogicRegressionTest().onReceive(c, null);
                check(c.manager.notified == 0, "Null intent posted a notification");
            });
            failures += run("conflict boundaries", () -> {
                Course saved = new Course(1, 0, 1, 2, "1-16周单周");
                app.courses.add(saved);
                check(app.hasCourseConflict(new Course(2, 0, 2, 3, "1-16周")), "Overlap missed");
                check(!app.hasCourseConflict(new Course(2, 0, 3, 4, "1-16周")), "Adjacent periods conflict");
                check(!app.hasCourseConflict(new Course(2, 0, 1, 2, "2-16周双周")), "Odd/even conflict");
            });
            failures += run("import conflict", () -> {
                Course imported = new Course(2, 0, 2, 3, "1-16周");
                imported.name = "Different course";
                int count = app.courses.size();
                check(app.importCourses(Arrays.asList(imported)) == 0, "Import bypassed the conflict check");
                check(app.courses.size() == count, "Conflicting course was stored");
            });
            failures += run("import different weeks", () -> {
                Course imported = new Course(3, 0, 1, 2, "2-16周双周");
                imported.name = "Even weeks";
                check(app.importCourses(Arrays.asList(imported)) == 1, "Nonoverlapping import rejected");
            });
            failures += run("import changed period rules", () -> {
                Course imported = new Course(4, 1, 12, 12, "1-16周");
                imported.name = "Period beyond current rules";
                check(app.importCourses(Arrays.asList(imported)) == 0, "Outdated parsed periods were imported");
            });
        } finally {
            TimeZone.setDefault(original);
        }
        if (failures > 0) throw new AssertionError(failures + " activity regression cases failed");
        System.out.println("ActivityLogicRegressionTest: all 20 cases passed");
    }

    private static void assertReminder(long generation, int requestCode, boolean expected) {
        schedule = new ScheduleData(7, new Entry(1));
        submitted = 0;
        Context c = new Context();
        Intent intent = new Intent().putExtra(EXTRA_GENERATION, generation)
                .putExtra(EXTRA_REQUEST_CODE, requestCode).putExtra(EXTRA_COURSE_NAME, "Math");
        new ActivityLogicRegressionTest().onReceive(c, intent);
        check(c.manager.notified == (expected ? 1 : 0), "Obsolete notification was delivered");
        check(submitted == (expected ? 1 : 0), "Wrong reminder chain advancement");
    }
    private static long date(int year, int month, int day) {
        Calendar c = Calendar.getInstance(); c.clear(); c.set(year, month, day);
        return c.getTimeInMillis();
    }
    private static int run(String name, Runnable test) {
        try { test.run(); System.out.println("PASS: " + name); return 0; }
        catch (Throwable error) { System.out.println("FAIL: " + name + ": " + error); return 1; }
    }
    private static void check(boolean condition, String message) {
        if (!condition) throw new AssertionError(message);
    }

