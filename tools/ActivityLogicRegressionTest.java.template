        final Map<String, Object> extras = new HashMap<>();
        Intent() {} Intent(Context c, Class<?> target) {}
        Intent putExtra(String key, Object value) { extras.put(key, value); return this; }
        long getLongExtra(String key, long fallback) { Object v = extras.get(key); return v instanceof Number ? ((Number)v).longValue() : fallback; }
        int getIntExtra(String key, int fallback) { Object v = extras.get(key); return v instanceof Number ? ((Number)v).intValue() : fallback; }
        String getStringExtra(String key) { return (String)extras.get(key); }
        boolean getBooleanExtra(String key, boolean fallback) { Object v = extras.get(key); return v instanceof Boolean ? (Boolean)v : fallback; }
