# Copy this file to secrets/release-signing.properties and fill in real values,
# or (preferred on CI) inject the same values via environment variables:
#   MEIN_STORE_FILE, MEIN_STORE_PASSWORD, MEIN_KEY_ALIAS, MEIN_KEY_PASSWORD
# Everything inside secrets/ is git-ignored. Never commit real credentials.
storeFile=<path to your keystore: project-relative or absolute>
storePassword=<store password>
keyAlias=<key alias>
keyPassword=<key password>