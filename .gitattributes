# Normalize line endings so a clone builds on every platform.
# Shell scripts must stay LF (a CRLF gradlew breaks ./gradlew on macOS/Linux);
# Windows batch/PowerShell helpers keep CRLF.

*          text=auto

*.java     text eol=lf
*.kt       text eol=lf
*.xml      text eol=lf
*.gradle   text eol=lf
*.properties text eol=lf
*.md       text eol=lf
*.pro      text eol=lf
gradlew    text eol=lf
.gitignore text eol=lf

*.bat      text eol=crlf
*.ps1      text eol=crlf

*.png      binary
*.jpg      binary
*.jar      binary
*.webp     binary
*.apk      binary
*.zip      binary
